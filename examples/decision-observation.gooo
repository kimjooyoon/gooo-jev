package jevdecision
namespace jevdecision

entity DecisionSpec id "gooo://jev/decision/spec"
entity DecisionReceipt id "gooo://jev/decision/receipt"
entity DecisionFreshness id "gooo://jev/decision/freshness"
entity DecisionReplay id "gooo://jev/decision/replay"
entity DecisionFeedback id "gooo://jev/decision/feedback"
entity DecisionFeedbackSummary id "gooo://jev/decision/feedback-summary"
entity DecisionFeedbackTrend id "gooo://jev/decision/feedback-trend"
entity DecisionFeedbackHistory id "gooo://jev/decision/feedback-history"
entity DecisionAssessment id "gooo://jev/decision/assessment"
entity DecisionCounterexample id "gooo://jev/decision/counterexample"
entity DecisionCounterexampleSet id "gooo://jev/decision/counterexample-set"
entity DecisionCausalReview id "gooo://jev/decision/causal-review"
entity DecisionCapabilityBoundary id "gooo://jev/decision/capability-boundary"
entity DecisionProvenanceEnvelope id "gooo://jev/decision/provenance-envelope"
entity DecisionMetricDelta id "gooo://jev/decision/metric-delta"
entity DecisionMetricLedger id "gooo://jev/decision/metric-ledger"

activity ObserveDecision(DecisionSpec) -> DecisionReceipt
activity ObserveDecisionFreshness(DecisionReceipt) -> DecisionFreshness
activity ReplayDecisionReceipt(DecisionReceipt) -> DecisionReplay
activity RecordDecisionFeedback(DecisionReplay) -> DecisionFeedback
activity SummarizeDecisionFeedback(DecisionFeedback) -> DecisionFeedbackSummary
activity CompareDecisionFeedback(DecisionFeedbackSummary) -> DecisionFeedbackTrend
activity BuildDecisionFeedbackHistory(DecisionFeedbackTrend) -> DecisionFeedbackHistory
activity AssessDecisionReceipt(DecisionReceipt) -> DecisionAssessment
activity RecordDecisionCounterexample(DecisionAssessment) -> DecisionCounterexample
activity BuildDecisionCounterexampleSet(DecisionAssessment) -> DecisionCounterexampleSet
activity BuildDecisionCausalReview(DecisionAssessment) -> DecisionCausalReview
activity ObserveDecisionCapabilityBoundary(DecisionAssessment) -> DecisionCapabilityBoundary
activity BindDecisionProvenanceEnvelope(DecisionReceipt) -> DecisionProvenanceEnvelope
activity ObserveDecisionMetricDelta(DecisionProvenanceEnvelope) -> DecisionMetricDelta
activity AppendDecisionMetricDelta(DecisionMetricLedger) -> DecisionMetricLedger
