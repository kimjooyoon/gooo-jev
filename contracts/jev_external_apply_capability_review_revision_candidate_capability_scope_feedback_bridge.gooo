package jevcapabilityscopefeedbackbridge

namespace jevcapabilityscopefeedbackbridge

entity CandidateCapabilityScopeFeedbackBridge {
  field status string
  field missing_stage string
  field candidate_digest string
  field candidate_source string
  field candidate_gate_digest string
  field application_plan_status string
  field plan_digest string
  field plan_source string
  field plan_evidence_digest string
  field application_plan_bridge_digest string
  field scope_status string
  field spiffe_id string
  field audience string
  field sandbox_policy_digest string
  field network_allowlist_digest string
  field scope_evidence_digest string
  field capability_scope_bridge_digest string
  field reverse_observation_status string
  field observation_digest string
  field observation_source string
  field observation_evidence_digest string
  field observation_metric_status string
  field observation_metric_digest string
  field observation_metric_source string
  field observation_metric_evidence_digest string
  field reverse_observation_bridge_digest string
  field feedback_direction string
  field feedback_digest string
  field feedback_source string
  field feedback_evidence_digest string
  field feedback_status string
  field bridge_digest string
  field non_executing bool
  field non_authorizing bool
}

activity BindCandidateCapabilityScopeFeedbackBridge {
  input CandidateCapabilityScopeFeedbackBridge
  output CandidateCapabilityScopeFeedbackBridge
  effect provenance-only
  effect execution none
  effect authorization none
}
