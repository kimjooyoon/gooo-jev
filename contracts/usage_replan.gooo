package usage_replan
namespace usage_replan

entity UsageObservationWindow id "gooo://gooo-jev/usage-observation-window"
entity UsageReplanObservation id "gooo://gooo-jev/usage-replan-observation"

activity MeasureUsageObservationWindow(UsageObservation) -> UsageObservationWindow
activity ProposeUsageReplan(UsageObservationWindow) -> UsageReplanObservation

status BOUND observation window provenance and metrics are valid
status UNKNOWN observation window is incomplete, invalid, or tampered
status PROPOSE_NEXT_ITERATION confirmed usage evidence supports another measurement window
status HOLD_FOR_EVIDENCE known usage evidence is insufficient or provenance is invalid
status REVIEW_NO_CONFIRMED_OUTCOME known evidence exists without a confirmed outcome

field status
field disposition
field next_operation
field window_digest
field evidence_digest
field missing_stage_index

constraint observation_only
constraint no_execution
constraint no_authorization
constraint unknown_preserves_first_missing_stage
constraint digest_replay_required