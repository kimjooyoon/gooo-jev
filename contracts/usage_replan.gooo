module usage_replan

input usage_observation
input usage_observation_window

status BOUND
status UNKNOWN
status PROPOSE_NEXT_ITERATION
status HOLD_FOR_EVIDENCE
status REVIEW_NO_CONFIRMED_OUTCOME

field status
field disposition
field next_operation
field window_digest
field evidence_digest
field missing_stage_index

constraint observation_only
constraint no_execution
constraint no_authorization
constraint unknown_preserves_first_missing_stage
constraint digest_replay_required
