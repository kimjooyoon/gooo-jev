package jevrevisionselfimprovementcyclemetric

namespace jevrevisionselfimprovementcyclemetric

entity RevisionSelfImprovementCycleMetricInput {
  property cycle_digest string
  property metric_name string
  property source_digest string
  property candidate_source_digest string
  property generated_ir_digest string
  property reverse_observation_digest string
  property direction string
  property baseline_value integer
  property candidate_value integer
}

entity RevisionSelfImprovementCycleMetricObservation {
  property status string
  property missing_stage string
  property cycle_digest string
  property metric_name string
  property source_digest string
  property candidate_source_digest string
  property generated_ir_digest string
  property reverse_observation_digest string
  property direction string
  property baseline_value integer
  property candidate_value integer
  property metric_delta integer
  property metric_signal string
  property metric_evidence_digest string
  property observation_digest string
  property non_executing boolean
  property non_authorizing boolean
}

activity ObserveRevisionSelfImprovementCycleMetric(RevisionSelfImprovementCycleMetricInput) -> RevisionSelfImprovementCycleMetricObservation