package jevdeclarationirgenerationbinding
namespace jevdeclarationirgenerationbinding

entity ExecutionEnvelopeDeclarationIRGenerationBindingInput id "gooo://gooo-jev/declaration-ir-generation-binding-input"
  property DeclarationID string
  property ContractID string
  property DeclarationDigest string
  property IRDigest string
  property GenerationDigest string

entity ExecutionEnvelopeDeclarationIRGenerationBinding id "gooo://gooo-jev/declaration-ir-generation-binding"
  property Status string
  property DeclarationID string
  property ContractID string
  property DeclarationDigest string
  property IRDigest string
  property GenerationDigest string
  property BindingDigest string
  property MissingStage string
  property NonExecuting boolean
  property NonAuthorizing boolean

entity ExecutionEnvelopeProvenanceChainBindingInput id "gooo://gooo-jev/provenance-chain-binding-input"
  property DeclarationID string
  property ContractID string
  property DeclarationDigest string
  property IRDigest string
  property GenerationDigest string
  property BindingDigest string
  property ReverseObservationDigest string
  property MetricDigest string
  property NonAuthorizing boolean

entity ExecutionEnvelopeProvenanceChainBinding id "gooo://gooo-jev/provenance-chain-binding"
  property Status string
  property MissingStage string
  property DeclarationID string
  property ContractID string
  property DeclarationDigest string
  property IRDigest string
  property GenerationDigest string
  property BindingDigest string
  property ReverseObservationDigest string
  property MetricDigest string
  property EvidenceDigest string
  property NonExecuting boolean
  property NonAuthorizing boolean

activity BindExecutionEnvelopeDeclarationIRGeneration(ExecutionEnvelopeDeclarationIRGenerationBindingInput) -> ExecutionEnvelopeDeclarationIRGenerationBinding
activity EvaluateExecutionEnvelopeProvenanceChainBinding(ExecutionEnvelopeProvenanceChainBindingInput) -> ExecutionEnvelopeProvenanceChainBinding
activity ValidateExecutionEnvelopeProvenanceChainBinding(ExecutionEnvelopeProvenanceChainBinding) -> ExecutionEnvelopeProvenanceChainBinding

entity ExecutionEnvelopeProvenanceChainMetric id "gooo://gooo-jev/provenance-chain-metric"
  property Status string
  property ObservedStageCount integer
  property ExpectedStageCount integer
  property MissingStage string
  property CompletenessDigest string
  property EvidenceDigest string
  property NonExecuting boolean
  property NonAuthorizing boolean

activity MeasureExecutionEnvelopeProvenanceChainMetric(ExecutionEnvelopeProvenanceChainBinding) -> ExecutionEnvelopeProvenanceChainMetric

entity ExecutionEnvelopeProvenanceChainReverseObservationInput id "gooo://gooo-jev/provenance-chain-reverse-observation-input"
  property DeclarationID string
  property ContractID string
  property DeclarationDigest string
  property IRDigest string
  property GenerationDigest string
  property BindingDigest string
  property ReverseObservationStatus string
  property ReverseObservationFirstMismatch string
  property ReverseObservationDigest string
  property MetricDigest string
  property NonAuthorizing boolean

activity EvaluateExecutionEnvelopeProvenanceChainBindingFromReverseObservation(ExecutionEnvelopeProvenanceChainReverseObservationInput) -> ExecutionEnvelopeProvenanceChainBinding

entity ExecutionEnvelopeDeclarationSourceDigestInput id "gooo://gooo-jev/declaration-source-digest-input"
  property DeclarationID string
  property ContractID string
  property SourceText string
  property NonAuthorizing boolean

entity ExecutionEnvelopeDeclarationSourceDigest id "gooo://gooo-jev/declaration-source-digest"
  property Status string
  property DeclarationID string
  property ContractID string
  property DeclarationDigest string
  property MissingStage string
  property NonExecuting boolean
  property NonAuthorizing boolean

activity ComputeExecutionEnvelopeDeclarationSourceDigest(ExecutionEnvelopeDeclarationSourceDigestInput) -> ExecutionEnvelopeDeclarationSourceDigest

entity ExecutionEnvelopeDeclarationIRGenerationSourceInput id "gooo://gooo-jev/declaration-ir-generation-source-input"
  property DeclarationID string
  property ContractID string
  property SourceText string
  property IRDigest string
  property GenerationDigest string
  property NonAuthorizing boolean

activity BindExecutionEnvelopeDeclarationIRGenerationFromSource(ExecutionEnvelopeDeclarationIRGenerationSourceInput) -> ExecutionEnvelopeDeclarationIRGenerationBinding

entity ExecutionEnvelopeArtifactDigestInput id "gooo://gooo-jev/artifact-digest-input"
  property ArtifactKind string
  property ArtifactText string
  property NonAuthorizing boolean

entity ExecutionEnvelopeArtifactDigest id "gooo://gooo-jev/artifact-digest"
  property Status string
  property ArtifactKind string
  property ArtifactDigest string
  property MissingStage string
  property NonExecuting boolean
  property NonAuthorizing boolean

activity ComputeExecutionEnvelopeArtifactDigest(ExecutionEnvelopeArtifactDigestInput) -> ExecutionEnvelopeArtifactDigest

entity ExecutionEnvelopeDeclarationIRGenerationArtifactSourceInput id "gooo://gooo-jev/declaration-ir-generation-artifact-source-input"
  property DeclarationID string
  property ContractID string
  property DeclarationSource string
  property IRSource string
  property GenerationSource string
  property NonAuthorizing boolean

activity BindExecutionEnvelopeDeclarationIRGenerationFromSources(ExecutionEnvelopeDeclarationIRGenerationArtifactSourceInput) -> ExecutionEnvelopeDeclarationIRGenerationBinding
