package jevexecutionscope
namespace jevexecutionscope

entity Task id "gooo://gooo-jev/task"
entity Workspace id "gooo://gooo-jev/workspace"
entity Gateway id "gooo://gooo-jev/gateway"
entity Model id "gooo://gooo-jev/model"
entity ExecutionScope id "gooo://gooo-jev/execution-scope"
entity ExecutionScopeGrant id "gooo://gooo-jev/execution-scope-grant"
entity ExecutionScopeReceipt id "gooo://gooo-jev/execution-scope-receipt"

activity BindExecutionScope(Task) -> ExecutionScope
activity GrantExecutionScope(ExecutionScope) -> ExecutionScopeGrant
activity RecordScopedExecution(ExecutionScopeGrant) -> ExecutionScopeReceipt
