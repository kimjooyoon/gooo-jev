package jev.gooo.lsp.lifecycle

entity SelfImprovementLifecycleSymbolResult {
    field status string
    field missing_stage string
    field source_digest string
    field ir_digest string
    field symbol_name string
    field symbol_kind string
    field symbol_digest string
    field execution_application_observation_digest string
    field outcome_observation_digest string
    field application_observation_digest string
    field metrics_binding_digest string
    field generation_assessment_digest string
    field plan_observation_digest string
    field plan_digest string
    field application_digest string
    field receipt_digest string
    field proposed_source_digest string
    field input_ir_digest string
    field proposed_ir_digest string
    field candidate_digest string
    field edit_digest string
    field changed_byte_count integer
    field changed_line_count integer
    field ir_changed boolean
    field generated_source_digest string
    field generated_ir_digest string
    field structure_digest string
    field exact_source_match boolean
    field structure_match boolean
    field decision_signal string
    field feedback_signal string
    field application_signal string
    field plan_observed boolean
    field application_observed boolean
    field lifecycle_signal string
    invariant non_executing
    invariant non_authorizing
}

activity explain_self_improvement_lifecycle {
    input source
    input symbol_name
    input revision_self_improvement_lifecycle_observation
    output self_improvement_lifecycle_symbol_result
}
