package jevrevisionselfimprovementcyclemetricfeedback

namespace jevrevisionselfimprovementcyclemetricfeedback

entity RevisionSelfImprovementCycleMetricFeedbackInput {
  property cycle_metric_digest string
  property cycle_digest string
  property metric_name string
  property direction string
  property baseline_value integer
  property candidate_value integer
  property metric_delta integer
  property metric_signal string
}

entity RevisionSelfImprovementCycleMetricFeedback {
  property status string
  property missing_stage string
  property cycle_metric_digest string
  property cycle_digest string
  property metric_name string
  property direction string
  property baseline_value integer
  property candidate_value integer
  property metric_delta integer
  property metric_signal string
  property feedback_signal string
  property feedback_reason string
  property requires_observation boolean
  property requires_review boolean
  property requires_replan boolean
  property requires_measurement boolean
  property feedback_digest string
  property non_executing boolean
  property non_authorizing boolean
}

activity ObserveRevisionSelfImprovementCycleMetricFeedback(RevisionSelfImprovementCycleMetricFeedbackInput) -> RevisionSelfImprovementCycleMetricFeedback