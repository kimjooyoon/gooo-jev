module revision_self_improvement_cycle_jev_calibration_decision_routing_plan_observation

input source_version
input contract_version
input declaration_digest
input ir_digest
input generated_digest
input reverse_observation_status
input reverse_observation_digest
input proposal_status
input plan_digest
input expected_plan_digest
input outcome_window_digest
input outcome_count
input producer_deferred

status BOUND for aligned declaration, IR, generated, reverse, plan, and outcome evidence
status DEFERRED for deferred plan or reverse observation producers
status UNKNOWN for missing stage, mismatched plan identity, unresolved reverse evidence, or empty outcomes

field target_stage
field observation_digest

constraint provenance_bound
constraint read_only
constraint no_edits
constraint no_command
constraint no_execution
constraint no_authorization