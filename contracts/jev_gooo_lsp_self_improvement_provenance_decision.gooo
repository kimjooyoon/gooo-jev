package jev.gooo.lsp.provenancedecision

entity SelfImprovementProvenanceDecisionSymbolResult {
    field status string
    field missing_stage string
    field source_digest string
    field ir_digest string
    field symbol_name string
    field symbol_kind string
    field symbol_digest string
    field current_lifecycle_observation_digest string
    field history_digest string
    field observation_count integer
    field stable_count integer
    field transitioned_count integer
    field metrics_change_count integer
    field generation_change_count integer
    field history_signal string
    field decision_signal string
    field decision_reason string
    field requires_observation boolean
    field requires_inspection boolean
    field requires_measurement boolean
    field result_digest string
    invariant non_executing
    invariant non_authorizing
}

activity explain_self_improvement_provenance_decision {
    input source
    input symbol_name
    input current_revision_self_improvement_lifecycle_observation
    input revision_self_improvement_provenance_history_observation
    input revision_self_improvement_provenance_decision_observation
    output self_improvement_provenance_decision_symbol_result
}
