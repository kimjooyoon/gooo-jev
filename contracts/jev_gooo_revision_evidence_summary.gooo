package jev.gooo.revision.evidence

entity RevisionEvidenceSummary {
    field status string
    field missing_stage string
    field chain_digest string
    field generation_binding_digest string
    field source_digest string
    field proposed_source_digest string
    field input_ir_digest string
    field proposed_ir_digest string
    field candidate_digest string
    field application_digest string
    field metrics_digest string
    field quality_digest string
    field feedback_digest string
    field materialization_digest string
    field generation_observation_digest string
    field generation_source_digest string
    field generated_source_digest string
    field generated_ir_digest string
    field structure_digest string
    field evidence_stage_count integer
    field exact_source_match boolean
    field structure_match boolean
    field reverse_observed boolean
    invariant non_executing
    invariant non_authorizing
}

activity summarize_revision_evidence {
    input revision_evidence_chain
    input revision_evidence_generation_binding
    input revision_metrics
    output revision_evidence_summary
}