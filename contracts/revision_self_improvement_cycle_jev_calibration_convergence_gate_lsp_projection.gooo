contract revision_self_improvement_cycle_jev_calibration_convergence_gate_lsp_projection {
  input revision_self_improvement_cycle_jev_calibration_convergence_gate_observation
  observe status missing_stage missing_stage_index metric_name gate_decision outcome_delta_signal choice_set_sensitivity_signal choice_set_decision_signal gate_observation_digest evidence_prefix_digest source_observation_digest reverse_observation_coverage_digest projection_signal observation_digest non_executing non_authorizing
  semantics {
    effect reverse_observation_only
    authority none
    preserves_gate_decision: true
    preserves_unknown_stage: true
    preserves_evidence_prefix_digest: true
  }
}