  property CurrentStatus string
  property PreviousMissingStage string
  property CurrentMissingStage string
  property PreviousObservedAt string
  property CurrentObservedAt string
  property PreviousObservationDigest string
  property CurrentObservationDigest string

entity ExecutionEnvelopeReverseObservationTransition id "gooo://gooo-jev/reverse-observation-transition"
