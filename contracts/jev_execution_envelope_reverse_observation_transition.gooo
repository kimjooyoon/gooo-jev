  property CurrentSchema string
  property PreviousExecutionReceiptDigest string
  property CurrentExecutionReceiptDigest string
  property PreviousObservedOutputDigest string
  property CurrentObservedOutputDigest string
  property PreviousVerifierDigest string
  property CurrentVerifierDigest string
