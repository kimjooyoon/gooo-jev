package jev.gooo.lsp.revision

entity RevisionEvidenceSymbolResult {
    field status string
    field missing_stage string
    field source_digest string
    field ir_digest string
    field symbol_name string
    field symbol_kind string
    field symbol_digest string
    field summary_digest string
    field chain_digest string
    field generation_binding_digest string
    field evidence_stage_count integer
    field exact_source_match boolean
    field structure_match boolean
    field reverse_observed boolean
    invariant non_executing
    invariant non_authorizing
}

activity explain_revision_evidence {
    input source
    input symbol_name
    input revision_evidence_summary
    output revision_evidence_symbol_result
}