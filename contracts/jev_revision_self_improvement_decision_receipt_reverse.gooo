package jevrevisionselfimprovementdecisionreverse

namespace jevrevisionselfimprovementdecisionreverse

entity RevisionSelfImprovementDecisionReceiptReverseInput {
  property decision_receipt_digest string
  property reverse_observation_digest string
  property decision_signal string
  property decision_reason string
  property reverse_signal string
  property provenance_reverse_signal string
}

entity RevisionSelfImprovementDecisionReceiptReverseObservation {
  property status string
  property missing_stage string
  property decision_receipt_digest string
  property reverse_observation_digest string
  property decision_signal string
  property decision_reason string
  property reverse_signal string
  property provenance_reverse_signal string
  property decision_feedback_signal string
  property signals_aligned boolean
  property observation_digest string
  property non_executing boolean
  property non_authorizing boolean
}

activity ObserveRevisionSelfImprovementDecisionReceiptReverseObservation(RevisionSelfImprovementDecisionReceiptReverseInput) -> RevisionSelfImprovementDecisionReceiptReverseObservation