  property VerifiedCount integer
  property ReviewCount integer
  property CounterexampleCount integer
  property UnknownCount integer
  property EvidenceSourceDigest string
  property NonAuthorizing boolean

entity JEVActionCandidateVerificationMetric id "gooo://gooo-jev/jev-action-candidate-verification-metric"
  property Status string
  property MetricName string
  property Total integer
  property VerifiedCount integer
  property ReviewCount integer
  property CounterexampleCount integer
  property UnknownCount integer
  property EvidenceSourceDigest string
