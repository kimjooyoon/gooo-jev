contract revision_self_improvement_cycle_jev_calibration_outcome_window {
  input {
    outcome_samples_digest: digest
    sample_count: integer
    correct_count: integer
    incorrect_count: integer
    abstained_count: integer
    evaluated_count: integer
    accuracy_milli: integer
    mean_confidence_milli: integer
    source_observation_digest: digest
    generation_trace_digest: digest
    reverse_observation_coverage_digest: digest
  }

  observe {
    status: bound | unknown
    missing_stage: stage?
    sample_count: integer
    correct_count: integer
    incorrect_count: integer
    abstained_count: integer
    evaluated_count: integer
    accuracy_milli: integer
    mean_confidence_milli: integer
    outcome_samples_digest: digest
    window_signal: "jev-calibration-outcome-window-observed" | "jev-calibration-outcome-window-unknown"
    observation_digest: digest
    read_only: true
    non_executing: true
    non_authorizing: true
  }

  semantics {
    requires_outcome_observation: true
    requires_outcome_backed_calibration: true
    requires_generation_trace: true
    requires_reverse_observation_coverage: true
    effect: observation_only
    authority: none
    decision: defer
  }
}
